# Copy this file to ".env" and fill in your values.

# Port the API listens on
PORT=8080

# ---------- AI Tutor (FREE) ----------
# Provider: "gemini" (free Google AI Studio key) or "ollama" (local, no key).
# Leave AI_PROVIDER blank to auto-pick gemini when a key is present.
AI_PROVIDER=gemini

# Google Gemini FREE API key — get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OR use a local model (free, offline, no key) via Ollama ---
# Set AI_PROVIDER=ollama, install Ollama, and run:  ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---------- Accounts (FREE — no database to install, no cloud signup) ----------
# Leave MONGODB_URI BLANK and the server keeps accounts in a local JSON file at
# server/.data/codequest-db.json. Sign up / log in work straight away.
# Set it only if you actually want MongoDB — nothing else changes.
#   Local:      mongodb://127.0.0.1:27017/codequest
#   Atlas free: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/codequest
MONGODB_URI=

# Where the JSON file store keeps its data (gitignored). Default: server/.data
DATA_DIR=

# Signs login tokens. Leave BLANK for local use — the server generates a strong
# secret once and saves it to .data/secret.json (delete that file to log
# everyone out). In production this MUST be a random string of 32+ characters.
JWT_SECRET=

# How long a login lasts, and the bcrypt cost (8-14; higher = slower + safer)
JWT_EXPIRES=7d
BCRYPT_ROUNDS=10

# Browser origins allowed to call this API directly (comma-separated).
# The Vite dev proxy means CORS usually is not even involved.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
